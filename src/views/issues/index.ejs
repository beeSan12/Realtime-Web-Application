<script type="module" src="./js/webSocket.js"></script>
<script type="module" src="./js/issueService.js"></script>
<div class="jumbotron">
  <div id="issuesContainer">
    <h1>Issues</h1>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Avatar</th>
          <th>Title</th>
          <th>Description</th>
          <th>Author</th>
          <th>State</th>
          <th>Actions</th>

        </tr>
      </thead>
      <tbody id="issues-list">
        <% if (typeof issues !=='undefined' && issues.length> 0) { %>
          <% issues.forEach(function(issue) { %>
            <tr data-id="<%= issue.iid %>">
              <td><img class="avatar" src="<%= issue.author.avatar_url %>" alt="Author's Avatar"
                  style="width:50px; height:50px;"></td>
              <td rows="2">
                <%= issue.title %>
              </td>

              <td rows="5">
                <%= issue.description %>
              </td>
              <td>
                <%= issue.author.id %>
              </td>

              <td>
                <%= issue.state %>
              </td>
              <td class="text-nowrap">
                <a href="./issues/<%= issue.iid %>/update">Update</a>
              </td>
            </tr>
            <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center">No issues found</td>
                </tr>
                <% } %>
      </tbody>
    </table>

    <!-- Template for the client script. The same as above, sort of. -->
    <template id="issue-template">
      <tr>
        <!-- <td><img class="avatar" src="" alt="Author's Avatar" style="width:50px; height:50px;"></td> -->
        <td><img class="avatar" style="width:50px; height:50px;"></td>

        <td class="title"></td>
        <td class="description"></td>
        <td class="author"></td>
        <td class="state"></td>
        <td class="text-nowrap">
          <a>Update</a>
        </td>
    
        <!-- <td class="text-nowrap">
            <a class="update-link" href="#">Update</a>
        </td> -->
        <!-- <td class="w-100"></td>
        <td class="text-nowrap">
          <a>Update</a>
        </td> -->
    
        <!-- <td><img class="avatar" src="" alt="Author's Avatar" style="width:50px;"></td>
        <td class="title"></td>
        <td class="description"></td>
        <td class="author"></td>
        <td class="state"></td>
        <td>
            <a class="update-link" href="#">Update</a>
        </td> -->
        <!-- <td class="text-center text-primary"></td>
        <td><img class="avatar" src="" alt="Author's Avatar" style="width:50px; height:50px;"></td>
        <td class="title"></td>
        <td class="description"></td>
        <td class="author"></td>
        <td class="state"></td>
        <td class="text-nowrap">
          <a href="#" class="update-link" data-id="">Update</a>
        </td> -->
      </tr>
    </template>
  </div>
</div>